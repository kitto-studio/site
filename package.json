{
  "name": "kitto-site",
  "type": "module",
  "private": true,
  "description": "Kitto Studio site, https://kitto.studio",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kitto-studio/site.git"
  },
  "engines": {
    "node": ">=24.0.0",
    "bun": ">=1.4.3"
  },
  "scripts": {
    "build": "bun scripts/build.ts",
    "dev": "bun scripts/serve.ts",
    "preview": "bun scripts/preview.ts",
    "deploy": "bun scripts/deploy.ts",
    "images": "bun scripts/images.ts",
    "icons": "bun scripts/icons.ts",
    "og": "bun scripts/og.ts",
    "lint": "biome check . && oxlint",
    "lint:fix": "biome check --write . && oxlint --fix",
    "format": "biome format --write .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --project unit --project integration --coverage",
    "deploy:ci": "bun scripts/deploy.ts --cli",
    "test:e2e": "playwright test",
    "test:e2e:update": "playwright test --update-snapshots",
    "test:e2e:update:linux": "docker run --rm --network host -v \"$PWD\":/work -w /work mcr.microsoft.com/playwright:v1.60.0-noble bash -c \"npm i -g bun && bun install && bunx playwright test --update-snapshots\""
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@biomejs/biome": "2.4.16",
    "@fontsource/golos-text": "5.3.0",
    "@fontsource/gothic-a1": "5.3.0",
    "@fontsource/m-plus-rounded-1c": "5.3.0",
    "@fontsource/noto-sans-sc": "5.3.1",
    "@fontsource/nunito": "5.3.0",
    "@moku-labs/ci": "1.5.7",
    "@moku-labs/common": "0.3.10",
    "@playwright/test": "1.60.0",
    "@resvg/resvg-js": "2.6.2",
    "@types/bun": "1.4.2",
    "@vitest/coverage-istanbul": "4.0.18",
    "eslint-plugin-jsdoc": "65.1.0",
    "eslint-plugin-unicorn": "63.0.0",
    "happy-dom": "20.9.0",
    "lefthook": "2.1.1",
    "oxlint": "1.86.0",
    "playwright": "1.60.0",
    "satori": "0.19.1",
    "sharp": "0.35.5",
    "typescript": "7.0.2",
    "vitest": "4.0.18"
  },
  "dependencies": {
    "@moku-labs/web": "2.4.11",
    "preact": "10.29.8",
    "preact-render-to-string": "6.8.2"
  }
}
